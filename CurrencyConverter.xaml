<Page
    x:Class="Calculator.CurrencyConverter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="pageLoaded"
    Background="{ThemeResource SystemControlAcrylicWindowBrush}">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Resources/Resources.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!-- Label style for From/To/Amount labels -->
			<Style x:Key="LabelStyle" TargetType="TextBlock">
				<Setter Property="FontFamily" Value="Arial" />
				<Setter Property="FontSize" Value="16" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Margin" Value="4,0" />
			</Style>

			<!-- ComboBox style for currency dropdowns -->
			<Style x:Key="ComboStyle" TargetType="ComboBox">
				<Setter Property="FontFamily" Value="Arial" />
				<Setter Property="FontSize" Value="16" />
				<Setter Property="HorizontalAlignment" Value="Stretch" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>

			<!-- TextBox style for amount input -->
			<Style x:Key="InputBoxStyle" TargetType="TextBox">
				<Setter Property="FontFamily" Value="Arial" />
				<Setter Property="FontSize" Value="28" />
				<Setter Property="HorizontalAlignment" Value="Stretch" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="TextAlignment" Value="Right" />
			</Style>

			<!-- TextBlock style for result display -->
			<Style x:Key="ResultBlockStyle" TargetType="TextBlock">
				<Setter Property="FontFamily" Value="Arial" />
				<Setter Property="FontSize" Value="36" />
				<Setter Property="HorizontalAlignment" Value="Right" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Foreground" Value="DodgerBlue" />
				<Setter Property="TextWrapping" Value="Wrap" />
			</Style>

			<!-- Button style for convert button -->
			<Style x:Key="ConvertButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBlueStyle}">
				<Setter Property="FontSize" Value="20" />
				<Setter Property="Padding" Value="0,12" />
			</Style>

			<!-- Button style for back button -->
			<Style x:Key="BackButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
				<Setter Property="FontSize" Value="16" />
				<Setter Property="Padding" Value="0,8" />
				<Setter Property="Background" Value="LightGray" />
			</Style>

			<!-- Image style for flag icons -->
			<Style x:Key="FlagImageStyle" TargetType="Image">
				<Setter Property="Width" Value="36" />
				<Setter Property="Height" Value="24" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Margin" Value="4,0,8,0" />
			</Style>
		</ResourceDictionary>
	</Page.Resources>

	<Grid Style="{StaticResource GridStyle}" Margin="4,32,4,4">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- Page title -->
		<TextBlock
            Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
            Text="Currency Converter"
            FontFamily="Arial" FontSize="28" FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,8" />

		<!-- Amount label -->
		<TextBlock
            Grid.Row="1" Grid.Column="0"
            Text="Amount:"
            Style="{StaticResource LabelStyle}" />

		<!-- Amount input textbox -->
		<TextBox
            x:Name="amountInput"
            Grid.Row="1" Grid.Column="1"
            PlaceholderText="Enter amount"
            Style="{StaticResource InputBoxStyle}" />

		<!-- From currency label -->
		<TextBlock
            Grid.Row="2" Grid.Column="0"
            Text="From:"
            Style="{StaticResource LabelStyle}" />

		<!-- From currency dropdown -->
		<ComboBox
            x:Name="fromCurrencyCombo"
            Grid.Row="2" Grid.Column="1"
            Style="{StaticResource ComboStyle}">
			<ComboBoxItem Tag="USD" IsSelected="True">
				<StackPanel Orientation="Horizontal">
					<Image Source="Images/USA1.PNG" Style="{StaticResource FlagImageStyle}" />
					<TextBlock Text="USD - US Dollar" VerticalAlignment="Center" />
				</StackPanel>
			</ComboBoxItem>
			<ComboBoxItem Tag="EUR">
				<StackPanel Orientation="Horizontal">
					<Image Source="Images/EUR1.PNG" Style="{StaticResource FlagImageStyle}" />
					<TextBlock Text="EUR - Euro" VerticalAlignment="Center" />
				</StackPanel>
			</ComboBoxItem>
			<ComboBoxItem Tag="GBP">
				<StackPanel Orientation="Horizontal">
					<Image Source="Images/UK1.PNG" Style="{StaticResource FlagImageStyle}" />
					<TextBlock Text="GBP - British Pound" VerticalAlignment="Center" />
				</StackPanel>
			</ComboBoxItem>
			<ComboBoxItem Tag="INR">
				<StackPanel Orientation="Horizontal">
					<Image Source="Images/INDIA.PNG" Style="{StaticResource FlagImageStyle}" />
					<TextBlock Text="INR - Indian Rupee" VerticalAlignment="Center" />
				</StackPanel>
			</ComboBoxItem>
		</ComboBox>

		<!-- To currency label -->
		<TextBlock
            Grid.Row="3" Grid.Column="0"
            Text="To:"
            Style="{StaticResource LabelStyle}" />

		<!-- To currency dropdown -->
		<ComboBox
            x:Name="toCurrencyCombo"
            Grid.Row="3" Grid.Column="1"
            Style="{StaticResource ComboStyle}">
			<ComboBoxItem Tag="USD">
				<StackPanel Orientation="Horizontal">
					<Image Source="Images/USA1.PNG" Style="{StaticResource FlagImageStyle}" />
					<TextBlock Text="USD - US Dollar" VerticalAlignment="Center" />
				</StackPanel>
			</ComboBoxItem>
			<ComboBoxItem Tag="EUR">
				<StackPanel Orientation="Horizontal">
					<Image Source="Images/EUR1.PNG" Style="{StaticResource FlagImageStyle}" />
					<TextBlock Text="EUR - Euro" VerticalAlignment="Center" />
				</StackPanel>
			</ComboBoxItem>
			<ComboBoxItem Tag="GBP">
				<StackPanel Orientation="Horizontal">
					<Image Source="Images/UK1.PNG" Style="{StaticResource FlagImageStyle}" />
					<TextBlock Text="GBP - British Pound" VerticalAlignment="Center" />
				</StackPanel>
			</ComboBoxItem>
			<ComboBoxItem Tag="INR" IsSelected="True">
				<StackPanel Orientation="Horizontal">
					<Image Source="Images/INDIA.PNG" Style="{StaticResource FlagImageStyle}" />
					<TextBlock Text="INR - Indian Rupee" VerticalAlignment="Center" />
				</StackPanel>
			</ComboBoxItem>
		</ComboBox>

		<!-- Convert button -->
		<Button
            Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
            Content="Convert"
            Style="{StaticResource ConvertButtonStyle}"
            Click="convertButton_Click" />

		<!-- Result label -->
		<TextBlock
            Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
            Text="Result:"
            Style="{StaticResource LabelStyle}"
            Margin="4,8,4,0" />

		<!-- Result display -->
		<TextBlock
            x:Name="resultDisplay"
            Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
            Text="--"
            Style="{StaticResource ResultBlockStyle}"
            Margin="4,0,4,4" />

		<!-- Error message display -->
		<TextBlock
            x:Name="errorDisplay"
            Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
            Text=""
            FontFamily="Arial" FontSize="14"
            Foreground="Red"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            Margin="4,0" />

		<!-- Back to menu button -->
		<Button
            Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
            Content="Back to Menu"
            Style="{StaticResource BackButtonStyle}"
            Click="backButton_Click" />
	</Grid>
</Page>
